            // Edit mode function removed - no longer needed

            // Get plants that are not in the sequencer
            function getAvailablePlants() {
                const sequencerPlantIds = new Set();
                for (let row = 0; row < 2; row++) {
                    for (let col = 0; col < 12; col++) {
                        const plantId = sequencer[row]?.[col];
                        if (plantId) {
                            sequencerPlantIds.add(plantId);
                        }
                    }
                }
                return plants.filter(
                    (plant) => !sequencerPlantIds.has(plant.id),
                );
            }

            // Setup plants list drop zone
            function setupPlantsListDropZone() {
                const list = document.getElementById("plants-list");
                if (!list) return;

                list.addEventListener("dragover", (e) => {
                    e.preventDefault();
                    if (e.dataTransfer) {
                        e.dataTransfer.dropEffect = "move";
                    }
                    list.classList.add("border-green-400", "bg-green-50");
                });

                list.addEventListener("dragleave", (e) => {
                    // Only remove highlight if leaving the list area
                    const rect = list.getBoundingClientRect();
                    const x = e.clientX;
                    const y = e.clientY;
                    if (
                        x < rect.left ||
                        x > rect.right ||
                        y < rect.top ||
                        y > rect.bottom
                    ) {
                        list.classList.remove(
                            "border-green-400",
                            "bg-green-50",
                        );
                    }
                });

                list.addEventListener("drop", async (e) => {
                    e.preventDefault();
                    list.classList.remove("border-green-400", "bg-green-50");

                    if (!e.dataTransfer) return;
                    const plantId = e.dataTransfer.getData("plant-id") || "";
                    const source = e.dataTransfer.getData("source") || "";

                    // Only handle drops from grid cells
                    if (source === "grid" && plantId) {
                        const sourceRow = parseInt(
                            e.dataTransfer.getData("source-row") || "0",
                        );
                        const sourceCol = parseInt(
                            e.dataTransfer.getData("source-col") || "0",
                        );
                        // Clear the plant from the grid
                        await updateSequencer(sourceRow, sourceCol, "");
                    }
                });
            }

