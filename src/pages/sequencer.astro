                        async function saveEffectLimits() {
                            // Build payload from form values
                            const out = { AC: {}, DC: {}, AMF: {}, CMF: {} };
                            function readPair(type, name) {
                                const minEl = document.getElementById(`limit-${type}-${name}-min`);
                                const maxEl = document.getElementById(`limit-${type}-${name}-max`);
                                if (!minEl || !maxEl) return;
                                let min = parseFloat(minEl.value);
                                let max = parseFloat(maxEl.value);
                                if (isNaN(min)) min = 0; if (isNaN(max)) max = min;
                                if (min > max) max = min;
                                out[type][name] = { min, max };
                            }
                            readPair('AC','frequency'); readPair('AC','voltage'); readPair('AC','phase');
                            readPair('DC','voltage'); readPair('DC','current');
                            readPair('AMF','frequency'); readPair('AMF','amplitude'); readPair('AMF','phase');
                            readPair('CMF','strength');
                            const dirSel = document.getElementById('limit-CMF-direction-default');
                            if (dirSel) {
                                out.CMF.direction_default = dirSel.value;
                                out.CMF.direction_options = ["vertical","horizontal"]; // fixed options
                            }
                            try {
                                const res = await fetch(`${API_BASE}/effect-limits`, {
                                    method: 'PUT', headers: { 'Content-Type':'application/json' }, body: JSON.stringify({ limits: out })
                                });
                                if (!res.ok) {
                                    const text = await res.text();
                                    console.error('Failed to save limits', res.status, text);
                                    throw new Error(text || `Failed to save limits (status ${res.status})`);
                                }
                                effectLimits = out;
                                // Close modal
                                const modal = document.getElementById('effect-limits-modal');
                                modal.classList.add('hidden'); modal.classList.remove('flex');
                            } catch (e) {
                                alert(e?.message || 'Failed to save limits');
                            }
                        }
            const API_BASE = "http://localhost:5000/api";
            /** @type {Array<{id: string, added_timestamp: string}>} */
            let plants = [];
            /** @type {string[][]} */
            let sequencer = Array(2)
                .fill(null)
                .map(() => Array(12).fill(""));
            /** @type {string[][]} */
            let effects = Array(2)
                .fill(null)
                .map(() => Array(12).fill(""));
            // Edit mode removed - both plants and effects are always visible
            /** @type {'plant' | 'effect' | null} */
            let currentDragType = null;

            // Simulation state
            let simulationState = {
                running: false,
                tick: 0,
                speed: 1.0,
                robots: [],
                tileAllocation: {
                    storage_cols: [0, 1, 2, 3, 4, 5, 6, 7],
                    em_exposure_cols: [8, 9, 10, 11],
                },
            };
            let simulationPollingInterval = null;

            // Effect property definitions
            const effectPropertySchemas = {
                AC: {
                    frequency: {
                        type: "number",
                        label: "Frequency (Hz)",
                        default: 60,
                    },
                    voltage: {
                        type: "number",
                        label: "Voltage (V)",
