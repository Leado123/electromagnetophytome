            let currentEffectPosition = null; // {row, col} for properties panel

            // Load effect properties and update subtile display
            async function loadEffectPropertiesForSubtile(
                subtile,
                row,
                col,
                effect,
                colors,
            ) {
                try {
                    const response = await fetch(
                        `${API_BASE}/effects/${row}/${col}/properties`,
                    );
                    const data = await response.json();
                    const properties = data.properties || {};
                    const schema = effectPropertySchemas[effect] || {};

                    // Find existing props container or create new one
                    let propsContainer = document.getElementById(
                        `effect-props-${row}-${col}`,
                    );
                    if (!propsContainer) {
                        propsContainer = document.createElement("div");
                        propsContainer.id = `effect-props-${row}-${col}`;
                        propsContainer.className =
                            "flex flex-col w-full pointer-events-none";
                        propsContainer.style.gap = "1px";
                        propsContainer.style.lineHeight = "1.2";
                        propsContainer.style.flex = "1";
                        subtile.appendChild(propsContainer);
                    } else {
                        // Clear existing content
                        propsContainer.innerHTML = "";
                    }

                    // Display properties in shorthand format (support min/max ranges)
                    Object.entries(schema).forEach(([key, def]) => {
                        const hasMin = properties[`${key}_min`] !== undefined;
                        const hasMax = properties[`${key}_max`] !== undefined;
                        const value =
                            properties[key] !== undefined
                                ? properties[key]
                                : def.default;
                        const minVal = hasMin
                            ? properties[`${key}_min`]
                            : value;
                        const maxVal = hasMax
                            ? properties[`${key}_max`]
                            : value;
                        const propLine = document.createElement("div");
                        propLine.className = "leading-tight";
                        propLine.style.fontSize = "10px";
                        propLine.style.color = colors.textColor;

                        const shorthandLabels = {
                            frequency: "F",
                            voltage: "V",
                            phase: "P",
                            current: "I",
                            amplitude: "A",
                            strength: "S",
                            direction: "D",
                        };
                        const shortLabel =
                            shorthandLabels[key] ||
                            key.substring(0, 1).toUpperCase();

                        function fmtNum(n) {
                            if (typeof n !== "number") return String(n);
                            if (n >= 1000) return (n / 1000).toFixed(1) + "k";
                            if (Math.abs(n) >= 1 && n % 1 === 0)
                                return n.toString();
                            return n.toFixed(2);
                        }
                        const minDisp = fmtNum(minVal);
                        const maxDisp = fmtNum(maxVal);
                        const displayText =
                            hasMin || hasMax
                                ? `${minDisp}-${maxDisp}`
                                : fmtNum(value);
                        const truncatedValue =
                            displayText.length > 9
                                ? displayText.substring(0, 9) + ".."
                                : displayText;

                        propLine.textContent = `${shortLabel}:${truncatedValue}`;
                        propLine.title = `${def.label}: ${displayText}`;
                        propsContainer.appendChild(propLine);
                    });
                } catch (error) {
                    console.error(
                        "Error loading effect properties for subtile:",
                        error,
                    );
                    // Keep default properties that were already shown
                }
            }

            // Load plants
            async function loadPlants() {
                try {
