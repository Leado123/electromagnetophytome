                                "font-bold pointer-events-none leading-tight";
                            effectLabel.style.fontSize = "11px";
                            effectLabel.style.color = colors.labelColor;
                            effectLabel.style.marginBottom = "2px";
                            effectLabel.textContent = effect;
                            effectSubtile.appendChild(effectLabel);

                            // Show default properties immediately, then update when loaded
                            const schema = effectPropertySchemas[effect] || {};
                            const propsContainer =
                                document.createElement("div");
                            propsContainer.id = `effect-props-${row}-${col}`;
                            propsContainer.className =
                                "flex flex-col w-full pointer-events-none";
                            propsContainer.style.gap = "1px";
                            propsContainer.style.lineHeight = "1.2";
                            propsContainer.style.overflow = "hidden";
                            propsContainer.style.flex = "1";

                            // Display default properties first
                            Object.entries(schema).forEach(([key, def]) => {
                                const propLine = document.createElement("div");
                                propLine.className = "leading-tight";
                                propLine.style.fontSize = "10px";
                                propLine.style.color = colors.textColor;

                                const shorthandLabels = {
                                    frequency: "F",
                                    voltage: "V",
                                    phase: "P",
                                    current: "I",
                                    amplitude: "A",
                                    strength: "S",
                                    direction: "D",
                                };

                                const shortLabel =
                                    shorthandLabels[key] ||
                                    key.substring(0, 1).toUpperCase();
                                let displayValue =
                                    typeof def.default === "number"
                                        ? def.default.toString()
                                        : def.default;
                                if (typeof def.default === "number") {
                                    if (def.default >= 1000) {
                                        displayValue =
                                            (def.default / 1000).toFixed(1) +
                                            "k";
                                    } else if (def.default % 1 === 0) {
                                        displayValue = def.default.toString();
                                    } else {
                                        displayValue = def.default.toFixed(1);
                                    }
                                }
                                const truncatedValue =
                                    displayValue.length > 5
                                        ? displayValue.substring(0, 5) + ".."
                                        : displayValue;

                                propLine.textContent = `${shortLabel}:${truncatedValue}`;
                                propLine.title = `${def.label}: ${def.default}`;
                                propsContainer.appendChild(propLine);
                            });

                            effectSubtile.appendChild(propsContainer);

                            // Load actual properties and update (async)
                            loadEffectPropertiesForSubtile(
                                effectSubtile,
                                row,
                                col,
                                effect,
                                colors,
                            );

                            // Drag handlers for effect subtile
                            effectSubtile.addEventListener("dragstart", (e) => {
                                currentDragType = "effect";
                                if (e.dataTransfer) {
                                    e.dataTransfer.setData("effect", effect);
                                    e.dataTransfer.setData(
                                        "source",
                                        "grid-effect",
                                    );
                                    e.dataTransfer.setData(
                                        "source-row",
                                        String(row),
                                    );
                                    e.dataTransfer.setData(
                                        "source-col",
                                        String(col),
                                    );
                                    e.dataTransfer.effectAllowed = "move";
                                    effectSubtile.style.opacity = "0.5";
                                }
                            });

                            effectSubtile.addEventListener("dragend", () => {
                                effectSubtile.style.opacity = "";
                                currentDragType = null;
                            });

                            // Disable per-tile editing: no click handler
                        } else {
                            effectSubtile.className =
                                "border border-dashed border-gray-300 rounded-sm p-1 flex flex-col items-center justify-center bg-gray-50";
                            effectSubtile.style.minHeight = "70px";
                            const emptyText = document.createElement("div");
                            emptyText.className = "text-[9px] text-gray-400";
                            emptyText.textContent = "effect";
                            effectSubtile.appendChild(emptyText);
                        }

                        // Add drop handlers to both subtiles
                        setupSubtileDropHandlers(
                            plantSubtile,
                            effectSubtile,
                            row,
                            col,
                        );

                        subtilesContainer.appendChild(plantSubtile);
                        subtilesContainer.appendChild(effectSubtile);
                        tileContainer.appendChild(subtilesContainer);
                        cellsDiv.appendChild(tileContainer);
                    }

                    rowDiv.appendChild(cellsDiv);
                    grid.appendChild(rowDiv);
                }
            }

            // Setup drop handlers for subtiles
            function setupSubtileDropHandlers(
                plantSubtile,
                effectSubtile,
                row,
                col,
            ) {
                // Plant drop handlers
                plantSubtile.addEventListener("dragover", (e) => {
                    if (!e.dataTransfer) return;
                    if (currentDragType === "effect") return;

                    e.preventDefault();
                    e.dataTransfer.dropEffect = "move";
                    plantSubtile.classList.add(
                        "border-blue-500",
                        "ring-2",
                        "ring-blue-300",
                        "ring-opacity-50",
                        "scale-105",
                    );
                });

                plantSubtile.addEventListener("dragleave", () => {
                    plantSubtile.classList.remove(
                        "border-blue-500",
                        "ring-2",
                        "ring-blue-300",
                        "ring-opacity-50",
                        "scale-105",
                    );
                    const plantId = sequencer[row]?.[col] || "";
                    if (plantId) {
                        plantSubtile.classList.add("border-blue-400");
                    } else {
                        plantSubtile.classList.add("border-gray-300");
                    }
                });

                plantSubtile.addEventListener("drop", async (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    plantSubtile.classList.remove(
                        "border-blue-500",
                        "ring-2",
                        "ring-blue-300",
                        "ring-opacity-50",
                        "scale-105",
                    );

                    if (!e.dataTransfer) return;
                    const plantId = e.dataTransfer.getData("plant-id") || "";
                    const source = e.dataTransfer.getData("source") || "";
                    const effect = e.dataTransfer.getData("effect") || "";

                    if (effect || !plantId) return;
                    if (source !== "list" && source !== "grid") return;

                    const sourceRow = e.dataTransfer.getData("source-row");
                    const sourceCol = e.dataTransfer.getData("source-col");

                    if (
                        source === "grid" &&
                        sourceRow === String(row) &&
                        sourceCol === String(col)
                    ) {
                        return;
                    }

                    // Check if plant is already in sequencer
                    for (let r = 0; r < 2; r++) {
                        for (let c = 0; c < 12; c++) {
                            if (
                                sequencer[r]?.[c] === plantId &&
                                !(r === row && c === col) &&
                                !(
                                    source === "grid" &&
                                    r === parseInt(sourceRow) &&
                                    c === parseInt(sourceCol)
                                )
                            ) {
                                alert(
                                    `Plant ${plantId.substring(0, 12)}... is already in the sequencer at position R${r + 1}, C${c + 1}`,
                                );
                                return;
                            }
                        }
                    }

                    await updateSequencer(row, col, plantId);
                });

                // Effect drop handlers
                effectSubtile.addEventListener("dragover", (e) => {
                    if (!e.dataTransfer) return;
                    if (currentDragType === "plant") return;

                    e.preventDefault();
                    e.dataTransfer.dropEffect = "move";
                    effectSubtile.classList.add(
                        "ring-2",
                        "ring-purple-300",
                        "ring-opacity-50",
                        "scale-105",
                    );
                });

                effectSubtile.addEventListener("dragleave", () => {
                    effectSubtile.classList.remove(
                        "ring-2",
                        "ring-purple-300",
                        "ring-opacity-50",
                        "scale-105",
                    );
                });

                effectSubtile.addEventListener("drop", async (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    effectSubtile.classList.remove(
                        "ring-2",
                        "ring-purple-300",
                        "ring-opacity-50",
                        "scale-105",
                    );

                    if (!e.dataTransfer) return;
                    const effect = e.dataTransfer.getData("effect") || "";
                    const source = e.dataTransfer.getData("source") || "";
                    const plantId = e.dataTransfer.getData("plant-id") || "";

                    if (plantId || !effect) return;
                    if (source !== "effects-list" && source !== "grid-effect")
                        return;

                    const sourceRow = e.dataTransfer.getData("source-row");
                    const sourceCol = e.dataTransfer.getData("source-col");

                    if (
                        source === "grid-effect" &&
                        sourceRow === String(row) &&
                        sourceCol === String(col)
                    ) {
                        return;
                    }

                    await updateEffects(row, col, effect);
                });

                // Also allow dropping on the tile container (auto-detect subtile)
                const tileContainer = plantSubtile.parentElement?.parentElement;
                if (tileContainer) {
                    tileContainer.addEventListener("dragover", (e) => {
                        if (!e.dataTransfer) return;
                        e.preventDefault();
                        e.dataTransfer.dropEffect = "move";

                        // Determine which subtile to highlight based on drag type
                        if (currentDragType === "plant") {
                            plantSubtile.classList.add(
                                "border-blue-500",
                                "ring-2",
                                "ring-blue-300",
                                "ring-opacity-50",
                            );
                        } else if (currentDragType === "effect") {
                            effectSubtile.classList.add(
                                "ring-2",
                                "ring-purple-300",
                                "ring-opacity-50",
                            );
                        }
                    });

                    tileContainer.addEventListener("dragleave", () => {
                        plantSubtile.classList.remove(
                            "border-blue-500",
                            "ring-2",
                            "ring-blue-300",
                            "ring-opacity-50",
                        );
                        effectSubtile.classList.remove(
                            "ring-2",
                            "ring-purple-300",
                            "ring-opacity-50",
                        );
                    });

                    tileContainer.addEventListener("drop", async (e) => {
                        e.preventDefault();
                        e.stopPropagation();
                        plantSubtile.classList.remove(
                            "border-blue-500",
                            "ring-2",
                            "ring-blue-300",
                            "ring-opacity-50",
                        );
                        effectSubtile.classList.remove(
                            "ring-2",
                            "ring-purple-300",
                            "ring-opacity-50",
                        );

                        if (!e.dataTransfer) return;
                        const plantId =
                            e.dataTransfer.getData("plant-id") || "";
                        const effect = e.dataTransfer.getData("effect") || "";
                        const source = e.dataTransfer.getData("source") || "";

                        // Auto-detect and route to correct subtile
                        if (plantId && !effect) {
                            // Plant drop - route to plant subtile
                            const fakeEvent = new DragEvent("drop", {
                                bubbles: true,
                                cancelable: true,
                            });
                            Object.defineProperty(fakeEvent, "dataTransfer", {
                                value: e.dataTransfer,
                            });
                            plantSubtile.dispatchEvent(fakeEvent);
                        } else if (effect && !plantId) {
                            // Effect drop - route to effect subtile
                            const fakeEvent = new DragEvent("drop", {
                                bubbles: true,
                                cancelable: true,
                            });
                            Object.defineProperty(fakeEvent, "dataTransfer", {
                                value: e.dataTransfer,
                            });
                            effectSubtile.dispatchEvent(fakeEvent);
                        }
                    });
                }
            }

            // Show effect properties panel
            async function showEffectProperties(row, col, effect) {
                currentEffectPosition = { row, col };
                const modal = document.getElementById(
                    "effect-properties-modal",
                );
                const content = document.getElementById(
                    "effect-properties-modal-content",
                );

                if (!modal || !content) return;

                // Show modal
                modal.classList.remove("hidden");
                modal.classList.add("flex");

                // Load current properties
                try {
                    const response = await fetch(
                        `${API_BASE}/effects/${row}/${col}/properties`,
                    );
                    const data = await response.json();
                    const properties = data.properties || {};
                    const schema = effectPropertySchemas[effect] || {};

                    // Build properties form
                    content.innerHTML = `
                        <div class="mb-4">
                            <div class="text-sm font-semibold text-gray-700 mb-2">Effect: ${effect}</div>
                            <div class="text-xs text-gray-500 mb-4">Position: R${row + 1}, C${col + 1}</div>
                        </div>
                        <div id="properties-form" class="space-y-3">
                            ${Object.entries(schema)
                                .map(([key, def]) => {
                                    const base =
                                        properties[key] !== undefined
                                            ? properties[key]
                                            : def.default;
                                    if (def.type === "number") {
                                        const minVal =
                                            properties[`${key}_min`] !==
                                            undefined
                                                ? properties[`${key}_min`]
                                                : base;
                                        const maxVal =
                                            properties[`${key}_max`] !==
                                            undefined
                                                ? properties[`${key}_max`]
                                                : base;
                                        return `
                                        <div>
                                            <label class="block text-xs font-medium text-gray-700 mb-1">${def.label}</label>
                                            <div class="space-y-2">
                                                <div class="flex items-center gap-2">
                                                    <span class="text-[11px] text-gray-500">Min</span>
                                                    <input type="number"
                                                           id="prop-${key}-min"
                                                           value="${minVal}"
                                                           step="any"
                                                           class="draggable-number w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500">
                                                </div>
                                                <div class="flex items-center gap-2">
                                                    <span class="text-[11px] text-gray-500">Max</span>
                                                    <input type="number"
                                                           id="prop-${key}-max"
                                                           value="${maxVal}"
                                                           step="any"
                                                           class="draggable-number w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500">
                                                </div>
                                                <div class="text-[11px] text-gray-400">Tip: Drag horizontally on the inputs to adjust values.</div>
                                            </div>
                                        </div>
                                    `;
                                    } else {
                                        return `
                                        <div>
                                            <label class="block text-xs font-medium text-gray-700 mb-1">${def.label}</label>
                                            <input type="text" 
                                                   id="prop-${key}" 
                                                   value="${base}" 
                                                   class="w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500">
                                        </div>
                                    `;
                                    }
                                })
                                .join("")}
                        </div>
                        <button id="save-properties-btn" class="w-full mt-4 px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors font-medium">
                            Save Properties
                        </button>
                    `;

                    // Setup save button
                    const saveBtn = document.getElementById(
                        "save-properties-btn",
                    );
                    if (saveBtn) {
                        saveBtn.addEventListener("click", async () => {
                            const props = {};
                            Object.keys(schema).forEach((key) => {
                                if (schema[key].type === "number") {
                                    const minInput = document.getElementById(
                                        `prop-${key}-min`,
                                    );
                                    const maxInput = document.getElementById(
                                        `prop-${key}-max`,
                                    );
                                    if (minInput && maxInput) {
                                        let minVal = parseFloat(minInput.value);
                                        let maxVal = parseFloat(maxInput.value);
                                        if (isNaN(minVal)) minVal = 0;
                                        if (isNaN(maxVal)) maxVal = minVal;
                                        // Enforce min <= max
                                        if (minVal > maxVal) maxVal = minVal;
                                        props[`${key}_min`] = minVal;
                                        props[`${key}_max`] = maxVal;
                                    }
                                } else {
                                    const input = document.getElementById(
                                        `prop-${key}`,
                                    );
                                    if (input) {
                                        props[key] = input.value;
                                    }
                                }
                            });

                            await saveEffectProperties(row, col, props);
                            // Re-render grid to show updated properties in subtile
                            renderGrid();
                        });
                    }
                } catch (error) {
                    console.error("Error loading properties:", error);
                    content.innerHTML = `<div class="text-red-500 text-sm">Error loading properties</div>`;
                }
            }

            // Save effect properties
            async function saveEffectProperties(row, col, properties) {
                try {
                    const response = await fetch(
                        `${API_BASE}/effects/${row}/${col}/properties`,
                        {
                            method: "PUT",
                            headers: {
                                "Content-Type": "application/json",
                            },
                            body: JSON.stringify({ properties }),
                        },
                    );

                    if (response.ok) {
                        const modal = document.getElementById(
                            "effect-properties-modal",
                        );
                        if (modal) {
                            modal.classList.add("hidden");
                            modal.classList.remove("flex");
                        }
                        // Show success message briefly
                        const saveBtn = document.getElementById(
                            "save-properties-btn",
                        );
                        if (saveBtn) {
                            const originalText = saveBtn.textContent;
                            saveBtn.textContent = "Saved!";
                            saveBtn.classList.add(
                                "bg-green-600",
                                "hover:bg-green-700",
                            );
                            setTimeout(() => {
                                saveBtn.textContent = originalText;
                                saveBtn.classList.remove(
                                    "bg-green-600",
                                    "hover:bg-green-700",
                                );
                            }, 1000);
                        }
                    } else {
                        const error = await response.json();
                        alert(`Failed to save properties: ${error.error}`);
                    }
                } catch (error) {
                    console.error("Error saving properties:", error);
                    alert("Failed to save properties");
                }
            }

            // Update effects position
            /**
             * @param {number} row
             * @param {number} col
             * @param {string} effect
             */
            async function updateEffects(row, col, effect) {
                try {
                    // Update the new position with effect type only (no per-tile properties)
                    const response = await fetch(`${API_BASE}/effects`, {
                        method: "PUT",
                        headers: {
                            "Content-Type": "application/json",
                        },
                        body: JSON.stringify({
                            row,
                            col,
                            effect
                        }),
                    });

                    if (!response.ok) {
                        throw new Error(
                            `HTTP error! status: ${response.status}`,
                        );
                    }

                    const data = await response.json();
                    effects = data.effects;
                    renderGrid();
                } catch (error) {
                    console.error("Error updating effects:", error);
                    alert("Failed to update effects: " + error.message);
                }
            }

            // Update sequencer position
            /**
             * @param {number} row
             * @param {number} col
             * @param {string} plantId
             */
            async function updateSequencer(row, col, plantId) {
                try {
                    // If placing a plant, first remove it from any other position
                    if (plantId) {
                        for (let r = 0; r < 2; r++) {
                            for (let c = 0; c < 12; c++) {
                                if (
                                    sequencer[r]?.[c] === plantId &&
                                    !(r === row && c === col)
                                ) {
                                    // Clear the old position
                                    const clearResponse = await fetch(
                                        `${API_BASE}/sequencer`,
                                        {
                                            method: "PUT",
                                            headers: {
                                                "Content-Type":
                                                    "application/json",
                                            },
                                            body: JSON.stringify({
                                                row: r,
                                                col: c,
                                                plant_id: "",
                                            }),
                                        },
                                    );
                                    const clearData =
                                        await clearResponse.json();
                                    sequencer = clearData.sequencer;
                                }
                            }
                        }
                    }

                    // Update the new position
                    const response = await fetch(`${API_BASE}/sequencer`, {
                        method: "PUT",
                        headers: {
                            "Content-Type": "application/json",
                        },
                        body: JSON.stringify({ row, col, plant_id: plantId }),
                    });

                    const data = await response.json();
                    sequencer = data.sequencer;
                    renderGrid();
                    renderPlants(); // Update plants list to reflect changes
                } catch (error) {
                    console.error("Error updating sequencer:", error);
                    alert("Failed to update sequencer");
                }
            }

            // Create new plant
            const createBtn = document.getElementById("create-plant-btn");
            if (createBtn && createBtn instanceof HTMLButtonElement) {
                createBtn.addEventListener("click", async () => {
                    const originalText = createBtn.innerHTML;
                    createBtn.disabled = true;
                    createBtn.innerHTML = `
                        <svg class="animate-spin w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        <span>Creating...</span>
                    `;
                    createBtn.classList.add("opacity-75", "cursor-not-allowed");

                    try {
                        const response = await fetch(`${API_BASE}/plants`, {
                            method: "POST",
                        });

                        if (response.ok) {
                            await loadPlants();
                        } else {
                            const error = await response.json();
                            alert(`Failed to create plant: ${error.error}`);
                        }
                    } catch (error) {
                        console.error("Error creating plant:", error);
                        alert(
                            "Failed to create plant. Make sure the Flask server is running.",
                        );
                    } finally {
                        createBtn.disabled = false;
                        createBtn.innerHTML = originalText;
                        createBtn.classList.remove(
                            "opacity-75",
                            "cursor-not-allowed",
                        );
                    }
                });
            }

            // Setup effects drag handlers and drop zone
            function setupEffectsDragHandlers() {
                const effectsList = document.getElementById("effects-list");
                if (!effectsList) return;

                const effectItems =
                    effectsList.querySelectorAll("[data-effect]");
                effectItems.forEach((item) => {
                    item.addEventListener("dragstart", (e) => {
                        // Effects from list are always draggable
                        currentDragType = "effect";
                        // Restore pointer events on all effect overlays (in case they were disabled)
                        document
                            .querySelectorAll("[data-effect-overlay]")
                            .forEach((overlay) => {
                                overlay.style.pointerEvents = "auto";
                            });
                        if (e.dataTransfer) {
                            const effect = item.dataset.effect || "";
                            e.dataTransfer.setData("effect", effect);
                            e.dataTransfer.setData("source", "effects-list");
                            e.dataTransfer.effectAllowed = "move";
                            item.classList.add("opacity-50", "scale-95");
                        }
                    });

                    item.addEventListener("dragend", () => {
                        item.classList.remove("opacity-50", "scale-95");
                        currentDragType = null;
                        // Restore pointer events on all effect overlays
                        document
                            .querySelectorAll("[data-effect-overlay]")
                            .forEach((overlay) => {
                                overlay.style.pointerEvents = "auto";
                            });
                    });
                });

                // Make effects list a drop zone
                effectsList.addEventListener("dragover", (e) => {
                    const source = e.dataTransfer?.getData("source") || "";
                    if (source === "grid-effect") {
                        e.preventDefault();
                        if (e.dataTransfer) {
                            e.dataTransfer.dropEffect = "move";
                        }
                        effectsList.classList.add(
                            "border-purple-400",
                            "bg-purple-50",
                        );
                    }
                });

                effectsList.addEventListener("dragleave", (e) => {
                    const rect = effectsList.getBoundingClientRect();
                    const x = e.clientX;
                    const y = e.clientY;
                    if (
                        x < rect.left ||
                        x > rect.right ||
                        y < rect.top ||
                        y > rect.bottom
                    ) {
                        effectsList.classList.remove(
                            "border-purple-400",
                            "bg-purple-50",
                        );
                    }
                });

                effectsList.addEventListener("drop", async (e) => {
                    e.preventDefault();
                    effectsList.classList.remove(
                        "border-purple-400",
                        "bg-purple-50",
                    );

                    if (!e.dataTransfer) return;
                    const effect = e.dataTransfer.getData("effect") || "";
                    const source = e.dataTransfer.getData("source") || "";

                    // Only handle drops from grid
                    if (source === "grid-effect" && effect) {
                        const sourceRow = parseInt(
                            e.dataTransfer.getData("source-row") || "0",
                        );
                        const sourceCol = parseInt(
                            e.dataTransfer.getData("source-col") || "0",
                        );
                        // Clear the effect from the grid
                        await updateEffects(sourceRow, sourceCol, "");
                    }
                });
            }

            // Close properties modal handlers
            const closePropertiesModalBtn = document.getElementById(
                "close-properties-modal-btn",
            );
            const propertiesModal = document.getElementById(
                "effect-properties-modal",
            );
            if (closePropertiesModalBtn && propertiesModal) {
                closePropertiesModalBtn.addEventListener("click", () => {
                    propertiesModal.classList.add("hidden");
                    propertiesModal.classList.remove("flex");
                    currentEffectPosition = null;
                });
                // Click outside to close
                propertiesModal.addEventListener("click", (e) => {
                    if (e.target === propertiesModal) {
                        propertiesModal.classList.add("hidden");
                        propertiesModal.classList.remove("flex");
                        currentEffectPosition = null;
                    }
                });
                // Escape to close
                document.addEventListener("keydown", (e) => {
                    if (
                        e.key === "Escape" &&
                        !propertiesModal.classList.contains("hidden")
                    ) {
                        propertiesModal.classList.add("hidden");
                        propertiesModal.classList.remove("flex");
                        currentEffectPosition = null;
                    }
                });
            }

            // Effect limits modal handlers
            const effectLimitsBtn = document.getElementById('effect-limits-btn');
            const effectLimitsModal = document.getElementById('effect-limits-modal');
            const closeEffectLimitsBtn = document.getElementById('close-effect-limits-btn');
            const saveEffectLimitsBtn = document.getElementById('save-effect-limits-btn');
            if (effectLimitsBtn && effectLimitsModal) {
                effectLimitsBtn.addEventListener('click', async () => {
                    await loadEffectLimits();
                    renderEffectLimitsForm();
                    effectLimitsModal.classList.remove('hidden');
                    effectLimitsModal.classList.add('flex');
                });
            }
            if (closeEffectLimitsBtn && effectLimitsModal) {
                closeEffectLimitsBtn.addEventListener('click', () => {
                    effectLimitsModal.classList.add('hidden');
                    effectLimitsModal.classList.remove('flex');
                });
                effectLimitsModal.addEventListener('click', (e) => {
                    if (e.target === effectLimitsModal) {
                        effectLimitsModal.classList.add('hidden');
                        effectLimitsModal.classList.remove('flex');
                    }
                });
            }
            if (saveEffectLimitsBtn) {
                saveEffectLimitsBtn.addEventListener('click', saveEffectLimits);
            }

            // Enable draggable number inputs (drag horizontally to adjust)
            function enableDraggableNumberInput(inputEl, onChange) {
                if (!inputEl) return;
                let dragging = false;
                let startX = 0;
                let startVal = 0;
                const sensitivity = 0.1; // value change per pixel
                const onMouseMove = (e) => {
                    if (!dragging) return;
                    const dx = e.clientX - startX;
                    let newVal = startVal + dx * sensitivity;
                    // Preserve decimals reasonably
                    const parsed = parseFloat(newVal.toFixed(4));
                    inputEl.value = String(parsed);
                    if (onChange) onChange(parsed);
                };
                const onMouseUp = () => {
                    if (!dragging) return;
                    dragging = false;
                    document.body.style.cursor = "";
                    window.removeEventListener("mousemove", onMouseMove);
                    window.removeEventListener("mouseup", onMouseUp);
                };
                inputEl.addEventListener("mousedown", (e) => {
                    dragging = true;
                    startX = e.clientX;
                    startVal = parseFloat(inputEl.value) || 0;
                    document.body.style.cursor = "ew-resize";
                    window.addEventListener("mousemove", onMouseMove);
                    window.addEventListener("mouseup", onMouseUp);
                });
            }

            // After modal opens, wire draggable inputs and keep min <= max
            document.addEventListener("click", (e) => {
                if (
                    e.target &&
                    (e.target.id === "save-properties-btn" ||
                        e.target.id === "effect-properties-modal")
                ) {
                    // No-op for save or backdrop click
                    return;
                }
                const modal = document.getElementById(
                    "effect-properties-modal",
                );
                if (!modal || modal.classList.contains("hidden")) return;
                const form = document.getElementById("properties-form");
                if (!form) return;
                // Attach once per open
                const attachedFlag = form.getAttribute(
                    "data-draggable-attached",
                );
                if (attachedFlag === "true") return;
                form.setAttribute("data-draggable-attached", "true");

                // For each numeric schema key, hook draggable and enforce constraints
                Object.entries(effectPropertySchemas).forEach(() => {}); // placeholder to keep scope clean
                const inputs = form.querySelectorAll(".draggable-number");
                inputs.forEach((el) => {
                    enableDraggableNumberInput(el, () => {
                        const id = el.id;
                        const isMin = id.endsWith("-min");
                        const baseId = isMin
                            ? id.slice(0, -4)
                            : id.slice(0, -4); // remove '-min' or '-max'
                        const minEl = document.getElementById(baseId + "min");
                        const maxEl = document.getElementById(baseId + "max");
                        if (minEl && maxEl) {
                            let minVal = parseFloat(minEl.value) || 0;
                            let maxVal = parseFloat(maxEl.value) || 0;
                            if (minVal > maxVal) {
                                if (isMin) {
                                    maxEl.value = String(minVal);
                                } else {
                                    minEl.value = String(maxVal);
                                }
                            }
                        }
                    });
                });
            });

            // Initialize
            setupPlantsListDropZone();
            setupEffectsDragHandlers();

            // Pane and section collapse/expand functionality
            let leftPaneCollapsed = false;
            let plantsSectionExpanded = true;
            let effectsSectionExpanded = true;

            // Toggle left pane (main collapse)
            function toggleLeftPane() {
                leftPaneCollapsed = !leftPaneCollapsed;
                const pane = document.getElementById("left-pane");
                const content = document.getElementById("left-pane-content");
                const header = document.getElementById("left-pane-header");
                const title = document.getElementById("left-pane-title");
                const icon = document.getElementById("toggle-left-pane-icon");

                if (!pane || !content || !header || !icon) return;

                if (leftPaneCollapsed) {
                    // Collapse: keep header visible with just button
                    pane.style.width = "32px"; // Just enough for the button
                    pane.style.minWidth = "32px";
                    content.style.display = "none";
                    if (title) title.style.display = "none";
                    icon.style.transform = "rotate(180deg)";
                    // Make header full width of collapsed pane
                    header.style.paddingLeft = "4px";
                    header.style.paddingRight = "4px";
                } else {
                    // Expand
                    pane.style.width = "320px";
                    pane.style.minWidth = "0";
                    content.style.display = "flex";
                    if (title) title.style.display = "block";
                    icon.style.transform = "rotate(0deg)";
                    // Restore header padding
                    header.style.paddingLeft = "";
                    header.style.paddingRight = "";
                }
            }

            // Toggle plants section - instant, no animation
            function togglePlantsSection() {
                plantsSectionExpanded = !plantsSectionExpanded;
                const content = document.getElementById(
                    "plants-section-content",
                );
                const icon = document.getElementById("plants-section-icon");

                if (!content || !icon) return;

                if (plantsSectionExpanded) {
                    // Expand: show instantly
                    content.style.display = "block";
                    content.style.maxHeight = "none";
                    icon.style.transform = "rotate(0deg)";
                } else {
                    // Collapse: hide instantly
                    content.style.display = "none";
                    content.style.maxHeight = "0";
                    icon.style.transform = "rotate(-90deg)";
                }
            }

            // Toggle effects section - instant, no animation
            function toggleEffectsSection() {
                effectsSectionExpanded = !effectsSectionExpanded;
                const content = document.getElementById(
                    "effects-section-content",
                );
                const icon = document.getElementById("effects-section-icon");

                if (!content || !icon) return;

                if (effectsSectionExpanded) {
                    // Expand: show instantly
                    content.style.display = "flex";
                    content.style.maxHeight = "none";
                    icon.style.transform = "rotate(0deg)";
                } else {
                    // Collapse: hide instantly
                    content.style.display = "none";
                    content.style.maxHeight = "0";
                    icon.style.transform = "rotate(-90deg)";
                }
            }

            // Setup toggle buttons
            const toggleLeftPaneBtn = document.getElementById(
                "toggle-left-pane-btn",
            );
            const togglePlantsSectionBtn = document.getElementById(
                "toggle-plants-section-btn",
            );
            const toggleEffectsSectionBtn = document.getElementById(
                "toggle-effects-section-btn",
            );

            if (toggleLeftPaneBtn) {
                toggleLeftPaneBtn.addEventListener("click", (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    toggleLeftPane();
                });
            }

            if (togglePlantsSectionBtn) {
                togglePlantsSectionBtn.addEventListener("click", (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    togglePlantsSection();
                });
            }

            if (toggleEffectsSectionBtn) {
                toggleEffectsSectionBtn.addEventListener("click", (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    toggleEffectsSection();
                });
            }

            // Initialize sections as expanded - instant
            const plantsContent = document.getElementById(
                "plants-section-content",
            );
            const effectsContent = document.getElementById(
                "effects-section-content",
            );
            if (plantsContent && plantsSectionExpanded) {
                plantsContent.style.display = "block";
                plantsContent.style.maxHeight = "none";
            }
            if (effectsContent && effectsSectionExpanded) {
                effectsContent.style.display = "flex";
                effectsContent.style.maxHeight = "none";
            }

            // Simulation functions
            async function loadSimulationState() {
                try {
                    const response = await fetch(
                        `${API_BASE}/simulation/state`,
                    );
                    if (!response.ok)
                        throw new Error("Failed to load simulation state");
                    const data = await response.json();
                    simulationState = {
                        running: data.running,
                        tick: data.tick,
                        speed: data.speed,
                        robots: data.robots || [],
                        tileAllocation:
                            data.tile_allocation ||
                            simulationState.tileAllocation,
                    };
                    updateSimulationUI();
                    renderRobots();
                    // Reload sequencer to reflect robot movements
                    await loadSequencer();
                    renderGrid();
                } catch (error) {
                    console.error("Error loading simulation state:", error);
                }
            }

            async function startSimulation() {
                try {
                    const response = await fetch(
                        `${API_BASE}/simulation/start`,
                        { method: "POST" },
                    );
                    if (response.ok) {
                        await loadSimulationState();
                        startSimulationPolling();
                    }
                } catch (error) {
                    console.error("Error starting simulation:", error);
                }
            }

            async function pauseSimulation() {
                try {
                    const response = await fetch(
                        `${API_BASE}/simulation/pause`,
                        { method: "POST" },
                    );
                    if (response.ok) {
                        await loadSimulationState();
                        stopSimulationPolling();
                    }
                } catch (error) {
                    console.error("Error pausing simulation:", error);
                }
            }

            async function resetSimulation() {
                try {
                    const response = await fetch(
                        `${API_BASE}/simulation/reset`,
                        { method: "POST" },
                    );
                    if (response.ok) {
                        stopSimulationPolling();
                        await loadSimulationState();
                    }
                } catch (error) {
                    console.error("Error resetting simulation:", error);
                }
            }

            async function setSimulationSpeed(speed) {
                try {
                    const response = await fetch(
                        `${API_BASE}/simulation/speed`,
                        {
                            method: "PUT",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({ speed }),
                        },
                    );
                    if (response.ok) {
                        const data = await response.json();
                        simulationState.speed = data.speed;
                        updateSimulationUI();
                    }
                } catch (error) {
                    console.error("Error setting simulation speed:", error);
                }
            }

            // Polling interval for simulation state updates (in milliseconds)
            const SIMULATION_POLL_INTERVAL_MS = 500;

            function startSimulationPolling() {
                if (simulationPollingInterval) return;
                simulationPollingInterval = setInterval(
                    loadSimulationState,
                    SIMULATION_POLL_INTERVAL_MS,
                );
            }

            function stopSimulationPolling() {
                if (simulationPollingInterval) {
                    clearInterval(simulationPollingInterval);
                    simulationPollingInterval = null;
                }
            }

            // Helper function to sanitize HTML special characters
            function escapeHtml(text) {
                const div = document.createElement("div");
                div.textContent = text;
                return div.innerHTML;
            }

            function updateSimulationUI() {
                const startBtn = document.getElementById(
                    "simulation-start-btn",
                );
                const pauseBtn = document.getElementById(
                    "simulation-pause-btn",
                );
                const tickDisplay = document.getElementById("tick-display");
                const speedDisplay = document.getElementById("speed-display");
                const statusDisplay =
                    document.getElementById("simulation-status");

                if (simulationState.running) {
                    startBtn?.classList.add("hidden");
                    pauseBtn?.classList.remove("hidden");
                    statusDisplay?.classList.remove(
                        "bg-gray-200",
                        "text-gray-700",
                    );
                    statusDisplay?.classList.add(
                        "bg-green-200",
                        "text-green-700",
                    );
                    if (statusDisplay) statusDisplay.textContent = "Running";
                } else {
                    startBtn?.classList.remove("hidden");
                    pauseBtn?.classList.add("hidden");
                    statusDisplay?.classList.remove(
                        "bg-green-200",
                        "text-green-700",
                    );
                    statusDisplay?.classList.add(
                        "bg-gray-200",
                        "text-gray-700",
                    );
                    if (statusDisplay) statusDisplay.textContent = "Stopped";
                }

                if (tickDisplay)
                    tickDisplay.textContent = simulationState.tick.toString();
                if (speedDisplay)
                    speedDisplay.textContent = `${simulationState.speed.toFixed(1)}x`;
                const speedInput = document.getElementById("speed-input");
                if (speedInput)
                    speedInput.value = simulationState.speed.toFixed(1);
            }

            function renderRobots() {
                const container = document.getElementById("robots-container");
                if (!container) return;

                container.innerHTML = "";

                // Also render robots visually on the grid
                renderRobotsOnGrid();

                simulationState.robots.forEach((robot) => {
                    const robotEl = document.createElement("div");

                    // Color based on state
                    let stateColor = "bg-gray-100 border-gray-300";
                    let stateText = robot.state;
                    if (robot.state === "idle") {
                        stateColor = "bg-green-100 border-green-300";
                        stateText = "Idle";
                    } else if (robot.state === "observing") {
                        stateColor = "bg-blue-100 border-blue-300";
                        stateText = "Observing";
                    } else if (robot.state.includes("moving")) {
                        stateColor = "bg-yellow-100 border-yellow-300";
                        stateText = "Moving";
                    } else if (
                        robot.state.includes("picking") ||
                        robot.state.includes("putting")
                    ) {
                        stateColor = "bg-orange-100 border-orange-300";
                        stateText = robot.state.includes("picking")
                            ? "Picking Up"
                            : "Putting Down";
                    }

                    // Sanitize plant ID to prevent XSS
                    const sanitizedPlantId = robot.holding_plant
                        ? escapeHtml(robot.holding_plant)
                        : "";
                    const truncatedPlantId =
                        sanitizedPlantId.length > 12
                            ? sanitizedPlantId.substring(0, 12) + "..."
                            : sanitizedPlantId;

                    // Sanitize numeric values for safety
                    const robotIdDisplay = escapeHtml(
                        String(Number(robot.id) + 1),
                    );
                    const rowDisplay = escapeHtml(
                        String(Number(robot.row) + 1),
                    );
                    const colDisplay = escapeHtml(Number(robot.col).toFixed(1));

                    robotEl.className = `p-2 rounded border ${stateColor}`;
                    robotEl.innerHTML = `
                        <div class="flex items-center justify-between mb-1">
                            <span class="text-xs font-bold text-gray-700">Robot ${robotIdDisplay}</span>
                            <span class="text-xs px-1.5 py-0.5 rounded ${stateColor}">${escapeHtml(stateText)}</span>
                        </div>
                        <div class="text-xs text-gray-600">
                            <div>Row: ${rowDisplay} | Col: ${colDisplay}</div>
                            ${robot.holding_plant ? `<div class="text-blue-600 truncate" title="${sanitizedPlantId}">Holding: ${truncatedPlantId}</div>` : ""}
                        </div>
                    `;
                    container.appendChild(robotEl);
                });
            }

            // Note: Robots are displayed only in the robot status panel above the grid, not overlaid on grid cells
            // This function is a stub - robot positions are shown in the status panel, not visually on grid tiles
            function renderRobotsOnGrid() {
                // Intentionally empty - robots are not rendered directly on grid cells
            }

            // Setup simulation control buttons
            const simStartBtn = document.getElementById("simulation-start-btn");
            const simPauseBtn = document.getElementById("simulation-pause-btn");
            const simResetBtn = document.getElementById("simulation-reset-btn");
            const speedSlowerBtn = document.getElementById("speed-slower-btn");
            const speedFasterBtn = document.getElementById("speed-faster-btn");

            if (simStartBtn) {
                simStartBtn.addEventListener("click", startSimulation);
            }
            if (simPauseBtn) {
                simPauseBtn.addEventListener("click", pauseSimulation);
            }
            if (simResetBtn) {
                simResetBtn.addEventListener("click", resetSimulation);
            }

            // Clear all button
            const clearAllBtn = document.getElementById("clear-all-btn");
            if (clearAllBtn) {
                clearAllBtn.addEventListener("click", async () => {
                    if (
                        !confirm(
                            "⚠️ WARNING: This will delete ALL data including:\n\n• All plants in sequencer\n• All EM effects\n• All growth data\n• Test queue\n• Simulation state\n\nThis cannot be undone! Are you sure?",
                        )
                    ) {
                        return;
                    }

                    clearAllBtn.disabled = true;
                    clearAllBtn.textContent = "Clearing...";

                    try {
                        const response = await fetch(`${API_BASE}/clear-all`, {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                        });

                        if (response.ok) {
                            const result = await response.json();
                            console.log("Clear all result:", result);

                            // Reload everything
                            await Promise.all([
                                loadPlants(),
                                loadSequencer(),
                                loadEffects(),
                                loadSimulationState(),
                            ]);
                            renderGrid();
                            renderRobots();

                            alert("✅ All data cleared successfully!");
                        } else {
                            const error = await response.json();
                            throw new Error(
                                error.error || "Failed to clear data",
                            );
                        }
                    } catch (error) {
                        console.error("Error clearing all data:", error);
                        alert("❌ Failed to clear data: " + error.message);
                    } finally {
                        clearAllBtn.disabled = false;
                        clearAllBtn.innerHTML = `
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                            </svg>
                            Clear All
                        `;
                    }
                });
            }

            if (speedSlowerBtn) {
                speedSlowerBtn.addEventListener("click", () => {
                    const newSpeed = Math.max(0.1, simulationState.speed - 0.5);
                    setSimulationSpeed(newSpeed);
                });
            }
            if (speedFasterBtn) {
                speedFasterBtn.addEventListener("click", () => {
                    const newSpeed = Math.min(
                        1000.0,
                        simulationState.speed + 0.5,
                    );
                    setSimulationSpeed(newSpeed);
                    if (speedInput) speedInput.value = newSpeed.toFixed(1);
                });
            }

            const speedInput = document.getElementById("speed-input");
            if (speedInput) {
                speedInput.addEventListener("change", () => {
                    const newSpeed = Math.max(
                        0.1,
                        Math.min(1000.0, parseFloat(speedInput.value) || 1.0),
                    );
                    setSimulationSpeed(newSpeed);
                });
                speedInput.addEventListener("blur", () => {
                    // Only validate, don't change if user is typing
                    const currentValue = parseFloat(speedInput.value);
                    if (
                        isNaN(currentValue) ||
                        currentValue < 0.1 ||
                        currentValue > 1000.0
                    ) {
                        // Invalid value, restore from state
                        speedInput.value = simulationState.speed.toFixed(1);
                    } else {
                        // Valid value, send to server
                        setSimulationSpeed(currentValue);
                    }
                });
                speedInput.addEventListener("keypress", (e) => {
                    // Allow Enter key to submit
                    if (e.key === "Enter") {
                        speedInput.blur();
                    }
                });
            }

            // Auto-populate plants button
            const autoPopulateBtn =
                document.getElementById("auto-populate-btn");
            if (autoPopulateBtn) {
                autoPopulateBtn.addEventListener("click", async () => {
                    autoPopulateBtn.disabled = true;
                    autoPopulateBtn.textContent = "Filling...";

                    try {
                        // Check current grid state before populating
                        const gridBefore = await fetch(
                            `${API_BASE}/sequencer`,
                        ).then((r) => r.json());
                        console.log("Grid before populate:", gridBefore);

                        const response = await fetch(
                            `${API_BASE}/sequencer/auto-populate`,
                            {
                                method: "POST",
                                headers: { "Content-Type": "application/json" },
                            },
                        );

                        if (response.ok) {
                            const result = await response.json();
                            console.log(`Auto-populate result:`, result);
                            console.log(
                                `Created ${result.created_count} plants, found ${result.empty_slots_found} empty slots`,
                            );

                            // Reload grid and refresh display
                            await loadSequencer();
                            await loadPlants();
                            renderGrid();

                            if (
                                result.created_count === 0 &&
                                result.empty_slots_found > 0
                            ) {
                                alert(
                                    `No plants created despite ${result.empty_slots_found} empty slots found. Check console for errors.`,
                                );
                            } else if (result.created_count > 0) {
                                console.log(
                                    `Successfully created ${result.created_count} plants`,
                                );
                            }
                        } else {
                            const errText = await response.text();
                            let err;
                            try {
                                err = JSON.parse(errText);
                            } catch {
                                err = { error: errText };
                            }
                            console.error("Auto-populate error:", err);
                            alert(
                                "Failed to auto-populate: " +
                                    (err.error || "Unknown error"),
                            );
                        }
                    } catch (error) {
                        console.error("Error auto-populating:", error);
                        alert(
                            "Failed to auto-populate plants: " + error.message,
                        );
                    } finally {
                        autoPopulateBtn.disabled = false;
                        autoPopulateBtn.innerHTML = `
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                            </svg>
                            Fill Plants
                        `;
                    }
                });
            }

            // Auto-set EM effects button
            const autoSetEmBtn = document.getElementById("auto-set-em-btn");
            if (autoSetEmBtn) {
                autoSetEmBtn.addEventListener("click", async () => {
                    autoSetEmBtn.disabled = true;
                    autoSetEmBtn.textContent = "Setting...";

                    try {
                        const response = await fetch(
                            `${API_BASE}/em-effects/auto-set`,
                            {
                                method: "POST",
                            },
                        );
                        const data = await response.json();

                        if (data.success) {
                            await loadEffects();
                            renderGrid();
                            alert(`Auto-set ${data.count} EM effect(s)`);
                        } else {
                            alert(
                                `Failed to auto-set EM effects: ${data.error}`,
                            );
                        }
                    } catch (error) {
                        console.error("Error auto-setting EM effects:", error);
                        alert("Failed to auto-set EM effects");
                    } finally {
                        autoSetEmBtn.disabled = false;
                        autoSetEmBtn.innerHTML = `
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                            </svg>
                            Auto EM
                        `;
                    }
                });
            }

            // Initialize: load all data, then render
            async function initialize() {
                try {
                    await Promise.all([
                        loadPlants(),
                        loadSequencer(),
                        loadEffects(),
                        loadSimulationState(),
                    ]);
                    // Render grid after all data is loaded
                    renderGrid();
                    renderRobots();
                    renderRobotsOnGrid();

                    // If simulation is running, start polling to auto-reload
                    if (simulationState.running) {
                        startSimulationPolling();
                    }
                } catch (error) {
                    console.error("Error during initialization:", error);
                    // Still render grid even if there's an error
                    renderGrid();
                }
            }

            initialize();
        </script>
    </body>
</html>
