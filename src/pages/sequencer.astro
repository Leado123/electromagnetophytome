---
import "../styles/global.css";

---

<html lang="en" class="h-full">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Sequencer</title>
        <style>
            html,
            body {
                height: 100%;
                margin: 0;
                padding: 0;
            }
            /* No transitions - instant changes */
        </style>
    </head>
    <body class="bg-gray-50 h-full overflow-hidden flex flex-col">
        <!-- Header -->
        <header
            class="bg-white border-b border-gray-300 px-4 py-2 flex-shrink-0"
        >
            <div class="flex items-center justify-between">
                <h1 class="text-lg font-semibold text-gray-900">Sequencer</h1>
                <p class="text-xs text-gray-600">
                    Drag plants and effects into the grid tiles
                </p>
            </div>
        </header>

        <!-- Main Content -->
        <main class="flex-1 flex flex-col bg-gray-50 overflow-hidden">
            <!-- Simulation Controls Bar -->
            <div
                class="bg-white border-b border-gray-300 px-4 py-2 flex items-center justify-between flex-shrink-0"
            >
                <div class="flex items-center gap-4">
                    <div class="flex items-center gap-2">
                        <button
                            id="simulation-start-btn"
                            class="px-3 py-1.5 bg-green-600 text-white text-sm font-medium rounded hover:bg-green-700 transition-colors flex items-center gap-1"
                        >
                            <svg
                                class="w-4 h-4"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"
                                ></path>
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                                ></path>
                            </svg>
                            Start
                        </button>
                        <button
                            id="simulation-pause-btn"
                            class="px-3 py-1.5 bg-yellow-600 text-white text-sm font-medium rounded hover:bg-yellow-700 transition-colors flex items-center gap-1 hidden"
                        >
                            <svg
                                class="w-4 h-4"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z"
                                ></path>
                            </svg>
                            Pause
                        </button>
                        <button
                            id="simulation-reset-btn"
                            class="px-3 py-1.5 bg-gray-600 text-white text-sm font-medium rounded hover:bg-gray-700 transition-colors flex items-center gap-1"
                        >
                            <svg
                                class="w-4 h-4"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                                ></path>
                            </svg>
                            Reset
                        </button>
                    </div>
                    <div class="h-6 w-px bg-gray-300"></div>
                    
                    <div class="flex items-center gap-2">
                        <span class="text-sm text-gray-600">Speed:</span>
                        <button
                            id="speed-slower-btn"
                            class="px-2 py-1 bg-gray-200 text-gray-700 text-sm rounded hover:bg-gray-300 transition-colors"
                            >−</button
                        >
                        <input
                            id="speed-input"
                            type="number"
                            min="0.1"
                            max="1000"
                            step="0.1"
                            value="1.0"
                            class="text-sm font-mono font-semibold w-20 text-center border border-gray-300 rounded px-2 py-1"
                        />
                        <span class="text-sm text-gray-600">x</span>
                        <button
                            id="speed-faster-btn"
                            class="px-2 py-1 bg-gray-200 text-gray-700 text-sm rounded hover:bg-gray-300 transition-colors"
                            >+</button
                        >
                    </div>
                    <div class="border-l border-gray-300 h-6 mx-2"></div>
                    <button
                        id="effect-limits-btn"
                        class="px-3 py-1.5 bg-indigo-600 text-white text-sm font-medium rounded hover:bg-indigo-700 transition-colors flex items-center gap-1"
                        title="Configure global EM effect limits"
                    >
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                        </svg>
                        Effect Limits
                    </button>
                    <button
                        id="auto-populate-btn"
                        class="px-3 py-1.5 bg-emerald-600 text-white text-sm font-medium rounded hover:bg-emerald-700 transition-colors flex items-center gap-1"
                    >
                        <svg
                            class="w-4 h-4"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                        </svg>
                        Fill Plants
                    </button>
                    <button
                        id="auto-set-em-btn"
                        class="px-3 py-1.5 bg-purple-600 text-white text-sm font-medium rounded hover:bg-purple-700 transition-colors flex items-center gap-1"
                    >
                        <svg
                            class="w-4 h-4"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                        Auto EM
                    </button>
                    <a
                        href="/graph"
                        class="px-3 py-1.5 bg-blue-600 text-white text-sm font-medium rounded hover:bg-blue-700 transition-colors flex items-center gap-1 no-underline"
                    >
                        <svg
                            class="w-4 h-4"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
                            ></path>
                        </svg>
                        Graph
                    </a>
                    <div class="border-l border-gray-300 h-6 mx-2"></div>
                    <button
                        id="clear-all-btn"
                        class="px-3 py-1.5 bg-red-600 text-white text-sm font-medium rounded hover:bg-red-700 transition-colors flex items-center gap-1"
                    >
                        <svg
                            class="w-4 h-4"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                            ></path>
                        </svg>
                        Clear All
                    </button>
                </div>
                <div class="flex items-center gap-4">
                    <div class="flex items-center gap-2">
                        <span class="text-sm text-gray-600">Tick:</span>
                        <span
                            id="tick-display"
                            class="text-sm font-mono font-bold text-blue-600"
                            >0</span
                        >
                    </div>
                    <div class="flex items-center gap-2">
                        <span
                            id="simulation-status"
                            class="text-sm font-medium px-2 py-0.5 rounded bg-gray-200 text-gray-700"
                            >Stopped</span
                        >
                    </div>
                </div>
            </div>

            <div class="flex flex-1 overflow-hidden">
                <!-- Left Sidebar (Plants & Effects) -->
                <aside
                    id="left-pane"
                    class="flex flex-col bg-white border-r border-gray-300"
                    style="width: 320px; min-width: 0;"
                >
                    <div
                        id="left-pane-header"
                        class="flex items-center justify-between p-2 h-14 bg-gray-100 border-b border-gray-300"
                    >
                        <div class="flex items-center gap-2">
                            <button
                                id="toggle-left-pane-btn"
                                class="p-1 hover:bg-gray-200 rounded"
                                title="Collapse/Expand"
                            >
                                <svg
                                    id="toggle-left-pane-icon"
                                    class="w-4 h-4 text-gray-600"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M9 5l7 7-7 7"></path>
                                </svg>
                            </button>
                            <h2
                                id="left-pane-title"
                                class="text-sm font-semibold text-gray-900"
                            >
                                Resources
                            </h2>
                        </div>
                    </div>
                    <div
                        id="left-pane-content"
                        class="flex-1 overflow-hidden flex flex-col"
                    >
                        <!-- Plants Section -->
                        <div class="border-b border-gray-200">
                            <button
                                id="toggle-plants-section-btn"
                                class="w-full flex items-center justify-between px-4 py-2 hover:bg-gray-50"
                            >
                                <div class="flex items-center gap-2">
                                    <svg
                                        id="plants-section-icon"
                                        class="w-3 h-3 text-gray-500"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M19 9l-7 7-7-7"></path>
                                    </svg>
                                    <h3
                                        class="text-sm font-semibold text-gray-900"
                                    >
                                        Plants
                                    </h3>
                                    <span
                                        id="plant-count"
                                        class="text-xs text-gray-500 bg-gray-200 px-2 py-0.5 rounded-full"
                                        >0</span
                                    >
                                </div>
                            </button>
                            <div
                                id="plants-section-content"
                                class="overflow-hidden transition-all duration-300"
                            >
                                <div class="px-4 pb-3">
                                    <button
                                        id="create-plant-btn"
                                        class="w-full px-3 py-2 bg-blue-600 text-white text-sm font-medium rounded hover:bg-blue-700 transition-colors flex items-center justify-center gap-2"
                                    >
                                        <svg
                                            class="w-4 h-4 flex-shrink-0"
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                            stroke-width="2.5"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                d="M12 4v16m8-8H4"></path>
                                        </svg>
                                        <span>Create New Plant</span>
                                    </button>
                                </div>
                                <div
                                    id="plants-list"
                                    class="px-4 pb-3 max-h-[400px] overflow-y-auto space-y-2"
                                    data-drop-zone="plants-list"
                                >
                                    <!-- Plants will be loaded here -->
                                    <div class="text-center text-gray-400 py-6">
                                        <svg
                                            class="w-8 h-8 mx-auto mb-2 opacity-50"
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M12 4v16m8-8H4"></path>
                                        </svg>
                                        <p class="text-xs">No plants yet</p>
                                        <p class="text-xs mt-1 opacity-75">
                                            Click button above
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Effects Section -->
                        <div class="flex-1 flex flex-col overflow-hidden">
                            <button
                                id="toggle-effects-section-btn"
                                class="w-full flex items-center justify-between px-4 py-2 hover:bg-gray-50"
                            >
                                <div class="flex items-center gap-2">
                                    <svg
                                        id="effects-section-icon"
                                        class="w-3 h-3 text-gray-500"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M19 9l-7 7-7-7"></path>
                                    </svg>
                                    <h3
                                        class="text-sm font-semibold text-gray-900"
                                    >
                                        Effects
                                    </h3>
                                </div>
                            </button>
                            <div
                                id="effects-section-content"
                                class="flex-1 overflow-hidden transition-all duration-300"
                            >
                                <div
                                    id="effects-list"
                                    class="px-4 py-3 overflow-y-auto space-y-2"
                                >
                                    <div
                                        class="p-3 bg-gradient-to-br from-purple-50 to-pink-50 border border-purple-200 rounded cursor-move hover:from-purple-100 hover:to-pink-100 hover:border-purple-300 transition-all duration-200"
                                        draggable="true"
                                        data-effect="AC"
                                    >
                                        <div
                                            class="font-bold text-purple-900 text-sm text-center"
                                        >
                                            AC
                                        </div>
                                        <div
                                            class="text-xs text-purple-600 text-center mt-1"
                                        >
                                            Alternating Current
                                        </div>
                                    </div>
                                    <div
                                        class="p-3 bg-gradient-to-br from-purple-50 to-pink-50 border border-purple-200 rounded cursor-move hover:from-purple-100 hover:to-pink-100 hover:border-purple-300 transition-all duration-200"
                                        draggable="true"
                                        data-effect="DC"
                                    >
                                        <div
                                            class="font-bold text-purple-900 text-sm text-center"
                                        >
                                            DC
                                        </div>
                                        <div
                                            class="text-xs text-purple-600 text-center mt-1"
                                        >
                                            Direct Current
                                        </div>
                                    </div>
                                    <div
                                        class="p-3 bg-gradient-to-br from-purple-50 to-pink-50 border border-purple-200 rounded cursor-move hover:from-purple-100 hover:to-pink-100 hover:border-purple-300 transition-all duration-200"
                                        draggable="true"
                                        data-effect="AMF"
                                    >
                                        <div
                                            class="font-bold text-purple-900 text-sm text-center"
                                        >
                                            AMF
                                        </div>
                                        <div
                                            class="text-xs text-purple-600 text-center mt-1"
                                        >
                                            Alternating Magnetic Field
                                        </div>
                                    </div>
                                    <div
                                        class="p-3 bg-gradient-to-br from-purple-50 to-pink-50 border border-purple-200 rounded cursor-move hover:from-purple-100 hover:to-pink-100 hover:border-purple-300 transition-all duration-200"
                                        draggable="true"
                                        data-effect="CMF"
                                    >
                                        <div
                                            class="font-bold text-purple-900 text-sm text-center"
                                        >
                                            CMF
                                        </div>
                                        <div
                                            class="text-xs text-purple-600 text-center mt-1"
                                        >
                                            Constant Magnetic Field
                                        </div>
                                    </div>
                                </div>

                                <!-- Effect Properties Panel -->
                                <!-- Effect Properties moved to modal popup -->
                            </div>
                        </div>
                    </div>
                </aside>

                <!-- Sequencer Grid -->
                <section class="flex-1 flex flex-col overflow-hidden bg-white">
                    <div
                        class="flex items-center justify-between p-2 px-4 h-14 bg-gray-100 border-b border-gray-300"
                    >
                        <div>
                            <h2 class="text-sm font-semibold text-gray-900">
                                Sequencer Grid
                            </h2>
                            <p class="text-xs text-gray-600">
                                2 rows × 12 columns (C1-8: Storage, C9-12: EM
                                Exposure)
                            </p>
                        </div>
                        <div class="flex items-center gap-3 text-xs">
                            <div class="flex items-center gap-1">
                                <div
                                    class="w-3 h-3 bg-blue-100 border border-blue-300 rounded"
                                >
                                </div>
                                <span class="text-gray-600">Storage</span>
                            </div>
                            <div class="flex items-center gap-1">
                                <div
                                    class="w-3 h-3 bg-purple-100 border border-purple-300 rounded"
                                >
                                </div>
                                <span class="text-gray-600">EM Zone</span>
                            </div>
                        </div>
                    </div>
                    <div class="flex-1 overflow-auto p-4">
                        <!-- Robot Status Panel -->
                        <div
                            id="robot-status-panel"
                            class="mb-4 p-3 bg-gray-50 rounded-lg border border-gray-200"
                        >
                            <h3
                                class="text-sm font-semibold text-gray-700 mb-2"
                            >
                                Observation Robots
                            </h3>
                            <div
                                id="robots-container"
                                class="grid grid-cols-2 gap-2"
                            >
                                <!-- Robot status will be rendered here -->
                            </div>
                        </div>
                        <div id="sequencer-grid" class="space-y-3">
                            <!-- Grid rows will be generated here -->
                        </div>
                    </div>
                </section>
            </div>
        </main>

        <!-- Effect Properties Modal -->
        <div
            id="effect-properties-modal"
            class="fixed inset-0 hidden z-50 items-center justify-center bg-black/50"
        >
            <div
                class="bg-white rounded-lg border border-gray-200 w-full max-w-md shadow-lg overflow-hidden"
            >
                <div
                    class="flex items-center justify-between px-3 py-2 bg-gray-50 border-b border-gray-200"
                >
                    <h3 class="text-sm font-semibold text-gray-900">
                        Effect Properties
                    </h3>
                    <button
                        id="close-properties-modal-btn"
                        class="text-gray-400 hover:text-gray-600 p-1"
                        aria-label="Close"
                    >
                        <svg
                            class="w-4 h-4"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>
                <div
                    id="effect-properties-modal-content"
                    class="p-3 max-h-[70vh] overflow-y-auto"
                >
                    <!-- Properties will be loaded here -->
                </div>
            </div>
        </div>

        <!-- Global Effect Limits Modal -->
        <div id="effect-limits-modal" class="fixed inset-0 hidden z-50 items-center justify-center bg-black/50">
            <div class="bg-white rounded-lg border border-gray-200 w-full max-w-2xl shadow-lg overflow-hidden">
                <div class="flex items-center justify-between px-4 py-2 bg-gray-50 border-b border-gray-200">
                    <h3 class="text-sm font-semibold text-gray-900">Global Effect Limits</h3>
                    <button id="close-effect-limits-btn" class="text-gray-400 hover:text-gray-600 p-1" aria-label="Close">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>
                <div id="effect-limits-content" class="p-4 max-h-[75vh] overflow-y-auto text-sm">
                    <!-- Limits form will be rendered here -->
                </div>
                <div class="px-4 py-2 bg-gray-50 border-t border-gray-200 flex items-center justify-end gap-2">
                    <button id="save-effect-limits-btn" class="px-4 py-2 bg-indigo-600 text-white rounded hover:bg-indigo-700 font-medium">Save Limits</button>
                </div>
            </div>
        </div>

        <script>
                        // Global effect limits state
                        let effectLimits = {
                            AC: { frequency: { min: 1, max: 1000 }, voltage: { min: 1, max: 240 }, phase: { min: 0, max: 360 } },
                            DC: { voltage: { min: 1, max: 48 }, current: { min: 0, max: 10 } },
                            AMF: { frequency: { min: 1, max: 1000 }, amplitude: { min: 0, max: 5 }, phase: { min: 0, max: 360 } },
                            CMF: { strength: { min: 0, max: 5 }, direction_options: ["vertical", "horizontal"], direction_default: "vertical" }
                        };

                        async function loadEffectLimits() {
                            try {
                                const res = await fetch(`${API_BASE}/effect-limits`);
                                if (res.ok) {
                                    const data = await res.json();
                                    effectLimits = data.limits || effectLimits;
                                }
                            } catch (e) {
                                console.warn('Failed to load effect limits, using defaults', e);
                            }
                        }

                        function renderEffectLimitsForm() {
                            const content = document.getElementById('effect-limits-content');
                            if (!content) return;
                            const sections = [
                                { key: 'AC', title: 'AC (Alternating Current)', fields: [ ['frequency','Hz'], ['voltage','V'], ['phase','°'] ] },
                                { key: 'DC', title: 'DC (Direct Current)', fields: [ ['voltage','V'], ['current','A'] ] },
                                { key: 'AMF', title: 'AMF (Alternating Magnetic Field)', fields: [ ['frequency','Hz'], ['amplitude','T'], ['phase','°'] ] },
                                { key: 'CMF', title: 'CMF (Constant Magnetic Field)', fields: [ ['strength','T'] ] }
                            ];
                            content.innerHTML = sections.map(sec => {
                                const limits = effectLimits[sec.key] || {};
                                const rows = sec.fields.map(([name, unit]) => {
                                    const min = limits[name]?.min ?? '';
                                    const max = limits[name]?.max ?? '';
                                    return `
                                        <div class="grid grid-cols-2 gap-2 items-center">
                                            <label class="text-xs font-medium text-gray-700">${name} (${unit})</label>
                                            <div class="flex gap-2">
                                                <input id="limit-${sec.key}-${name}-min" type="number" step="any" value="${min}" class="draggable-number w-full px-2 py-1 border border-gray-300 rounded" placeholder="min" />
                                                <input id="limit-${sec.key}-${name}-max" type="number" step="any" value="${max}" class="draggable-number w-full px-2 py-1 border border-gray-300 rounded" placeholder="max" />
                                            </div>
                                        </div>`;
                                }).join('');
                                // CMF direction options
                                let dirRow = '';
                                if (sec.key === 'CMF') {
                                    const opts = limits.direction_options || ["vertical","horizontal"];
                                    const def = limits.direction_default || 'vertical';
                                    dirRow = `
                                        <div class="grid grid-cols-2 gap-2 items-center">
                                            <label class="text-xs font-medium text-gray-700">direction</label>
                                            <select id="limit-CMF-direction-default" class="w-full px-2 py-1 border border-gray-300 rounded">
                                                ${opts.map(o => `<option value="${o}" ${o===def?'selected':''}>${o}</option>`).join('')}
                                            </select>
                                        </div>`;
                                }
                                return `
                                    <div class="mb-4 p-3 border rounded">
                                        <div class="text-xs font-semibold text-gray-800 mb-2">${sec.title}</div>
                                        <div class="space-y-2">
                                            ${rows}
                                            ${dirRow}
                                        </div>
                                    </div>`;
