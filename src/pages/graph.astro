---
import '../styles/global.css';
---

<html lang="en" class="h-full">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Plant Growth Analysis | EMP</title>
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1"></script>
    </head>
    <body class="bg-slate-900 h-full overflow-hidden flex flex-col text-slate-100">
        <!-- Header -->
        <header class="bg-slate-800 border-b border-slate-700 px-6 py-3 flex-shrink-0">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <h1 class="text-xl font-bold text-white">📊 Growth Analysis</h1>
                    <div class="flex items-center gap-2 text-sm">
                        <span class="px-2 py-1 bg-slate-700 rounded-md">
                            <span class="text-slate-400">Points:</span>
                            <span id="data-point-count" class="text-emerald-400 font-mono font-bold">0</span>
                        </span>
                        <span id="last-update" class="text-slate-500 text-xs"></span>
                    </div>
                </div>
                <div class="flex items-center gap-4">
                    <div class="flex items-center gap-2">
                        <span class="text-sm text-slate-400">Auto-refresh:</span>
                        <select id="refresh-rate" class="px-2 py-1 bg-slate-700 border border-slate-600 rounded text-sm text-white focus:outline-none focus:ring-2 focus:ring-emerald-500">
                            <option value="0">Off</option>
                            <option value="2000">2s</option>
                            <option value="5000" selected>5s</option>
                            <option value="10000">10s</option>
                        </select>
                    </div>
                    <button id="refresh-btn" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium rounded transition-colors">
                        ↻ Refresh
                    </button>
                    <a href="/sequencer" class="px-3 py-1.5 bg-slate-700 hover:bg-slate-600 text-slate-200 text-sm rounded transition-colors">
                        ← Sequencer
                    </a>
                </div>
            </div>
        </header>

        <!-- Main Content -->
        <main class="flex-1 overflow-auto p-4">
            <div class="grid grid-cols-12 gap-4 h-full" style="min-height: 800px;">
                
                <!-- Main Area: Parameter Response Curves (Large) -->
                <div class="col-span-9 grid grid-cols-2 gap-4">
                    <!-- AC Effect -->
                    <div class="bg-slate-800 rounded-xl border border-slate-700 p-4 flex flex-col" style="min-height: 380px;">
                        <div class="flex items-center justify-between mb-2">
                            <h2 class="text-base font-bold text-orange-400">⚡ AC Effect</h2>
                            <select id="ac-param-select" class="px-2 py-1 bg-slate-700 border border-slate-600 rounded text-xs text-white">
                                <option value="ac_frequency">Frequency (Hz)</option>
                                <option value="ac_voltage">Voltage (V)</option>
                                <option value="ac_phase">Phase</option>
                            </select>
                        </div>
                        <div class="flex-1" style="min-height: 320px;">
                            <canvas id="chart-ac"></canvas>
                        </div>
                    </div>
                    
                    <!-- DC Effect -->
                    <div class="bg-slate-800 rounded-xl border border-slate-700 p-4 flex flex-col" style="min-height: 380px;">
                        <div class="flex items-center justify-between mb-2">
                            <h2 class="text-base font-bold text-red-400">🔋 DC Effect</h2>
                            <select id="dc-param-select" class="px-2 py-1 bg-slate-700 border border-slate-600 rounded text-xs text-white">
                                <option value="dc_voltage">Voltage (V)</option>
                                <option value="dc_current">Current (A)</option>
                            </select>
                        </div>
                        <div class="flex-1" style="min-height: 320px;">
                            <canvas id="chart-dc"></canvas>
                        </div>
                    </div>
                    
                    <!-- AMF Effect -->
                    <div class="bg-slate-800 rounded-xl border border-slate-700 p-4 flex flex-col" style="min-height: 380px;">
                        <div class="flex items-center justify-between mb-2">
                            <h2 class="text-base font-bold text-purple-400">🧲 AMF Effect</h2>
                            <select id="amf-param-select" class="px-2 py-1 bg-slate-700 border border-slate-600 rounded text-xs text-white">
                                <option value="amf_frequency">Frequency (Hz)</option>
                                <option value="amf_amplitude">Amplitude</option>
                                <option value="amf_phase">Phase</option>
                            </select>
                        </div>
                        <div class="flex-1" style="min-height: 320px;">
                            <canvas id="chart-amf"></canvas>
                        </div>
                    </div>
                    
                    <!-- CMF Effect -->
                    <div class="bg-slate-800 rounded-xl border border-slate-700 p-4 flex flex-col" style="min-height: 380px;">
                        <div class="flex items-center justify-between mb-2">
                            <h2 class="text-base font-bold text-indigo-400">🧭 CMF Effect</h2>
                            <select id="cmf-param-select" class="px-2 py-1 bg-slate-700 border border-slate-600 rounded text-xs text-white">
                                <option value="cmf_strength">Strength</option>
                                <option value="cmf_direction">Direction</option>
                            </select>
                        </div>
                        <div class="flex-1" style="min-height: 320px;">
                            <canvas id="chart-cmf"></canvas>
                        </div>
                    </div>
                </div>
                
                <!-- Right Column: Stats & Overview -->
                <div class="col-span-3 flex flex-col gap-4">
                    <!-- Effect Comparison -->
                    <div class="bg-slate-800 rounded-xl border border-slate-700 p-4" style="height: 220px;">
                        <h2 class="text-sm font-semibold text-slate-300 mb-2">Mean Growth by Effect</h2>
                        <div style="height: 170px;">
                            <canvas id="chart-comparison"></canvas>
                        </div>
                    </div>
                    
                    <!-- Stats Summary -->
                    <div class="bg-slate-800 rounded-xl border border-slate-700 p-4 flex-1">
                        <h2 class="text-sm font-semibold text-slate-300 mb-3">Data Coverage</h2>
                        <div class="space-y-2 text-xs">
                            <div class="bg-slate-700/50 rounded p-2">
                                <div class="flex justify-between items-center">
                                    <span class="text-slate-400">AC</span>
                                    <span id="stat-ac" class="text-orange-400 font-mono font-bold">0</span>
                                </div>
                            </div>
                            <div class="bg-slate-700/50 rounded p-2">
                                <div class="flex justify-between items-center">
                                    <span class="text-slate-400">DC</span>
                                    <span id="stat-dc" class="text-red-400 font-mono font-bold">0</span>
                                </div>
                            </div>
                            <div class="bg-slate-700/50 rounded p-2">
                                <div class="flex justify-between items-center">
                                    <span class="text-slate-400">AMF</span>
                                    <span id="stat-amf" class="text-purple-400 font-mono font-bold">0</span>
                                </div>
                            </div>
                            <div class="bg-slate-700/50 rounded p-2">
                                <div class="flex justify-between items-center">
                                    <span class="text-slate-400">CMF</span>
                                    <span id="stat-cmf" class="text-indigo-400 font-mono font-bold">0</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <script is:inline>
            const API_BASE = 'http://localhost:5000/api';
            
            let dataPoints = [];
            let refreshInterval = null;
            let refreshRate = 5000;
            let lastDataHash = null;
            
            // Store chart instances
            const charts = {
                'AC': null,
                'DC': null,
                'AMF': null,
                'CMF': null,
                'comparison': null
            };
            
            const effectColors = {
                'AC': '#f97316',
                'DC': '#ef4444',
                'AMF': '#a855f7',
                'CMF': '#6366f1'
            };
            
            const effectParams = {
                'AC': {
                    'ac_frequency': { label: 'Frequency (Hz)', unit: ' Hz' },
                    'ac_voltage': { label: 'Voltage (V)', unit: ' V' },
                    'ac_phase': { label: 'Phase', unit: '°' }
                },
                'DC': {
                    'dc_voltage': { label: 'Voltage (V)', unit: ' V' },
                    'dc_current': { label: 'Current (A)', unit: ' A' }
                },
                'AMF': {
                    'amf_frequency': { label: 'Frequency (Hz)', unit: ' Hz' },
                    'amf_amplitude': { label: 'Amplitude', unit: '' },
                    'amf_phase': { label: 'Phase', unit: '°' }
                },
                'CMF': {
                    'cmf_strength': { label: 'Strength', unit: '' },
                    'cmf_direction': { label: 'Direction', unit: '°' }
                }
            };
            
            const selectedParams = {
                'AC': 'ac_frequency',
                'DC': 'dc_voltage',
                'AMF': 'amf_frequency',
                'CMF': 'cmf_strength'
            };
            
            function calcStats(values) {
                if (!values.length) return { mean: 0, std: 0 };
                const mean = values.reduce((a, b) => a + b, 0) / values.length;
                const variance = values.reduce((a, b) => a + Math.pow(b - mean, 2), 0) / values.length;
                return { mean, std: Math.sqrt(variance) };
            }
            
            function hashData(data) {
                return JSON.stringify(data.slice(-50).map(p => ({ 
                    tick: p.tick, 
                    growth: Math.round(p.growth * 1000) / 1000,
                    effect: p.effect_type 
                })));
            }
            
            async function fetchData() {
                try {
                    const response = await fetch(`${API_BASE}/plant-growth/unified`);
                    if (!response.ok) {
                        console.error('Failed to fetch:', response.status);
                        return;
                    }
                    const result = await response.json();
                    
                    if (result.data_points) {
                        const newHash = hashData(result.data_points);
                        if (newHash !== lastDataHash) {
                            dataPoints = result.data_points;
                            lastDataHash = newHash;
                            document.getElementById('data-point-count').textContent = result.count;
                            document.getElementById('last-update').textContent = `Updated ${new Date().toLocaleTimeString()}`;
                            updateAllGraphs();
                        }
                    }
                } catch (error) {
                    console.error('Error fetching data:', error);
                }
            }
            
            function updateAllGraphs() {
                renderParameterCharts();
                renderComparison();
                updateStats();
            }
            
            function renderParameterCharts() {
                ['AC', 'DC', 'AMF', 'CMF'].forEach(effect => {
                    const ctx = document.getElementById(`chart-${effect.toLowerCase()}`);
                    if (!ctx) return;
                    
                    const filtered = dataPoints.filter(p => p.effect_type === effect);
                    const paramName = selectedParams[effect];
                    const paramInfo = effectParams[effect][paramName];
                    
                    if (charts[effect]) charts[effect].destroy();
                    
                    if (filtered.length === 0) {
                        charts[effect] = new Chart(ctx, {
                            type: 'line',
                            data: { datasets: [] },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                plugins: {
                                    legend: { display: false },
                                    title: { display: true, text: `No ${effect} data`, color: '#64748b', font: { size: 12 } }
                                }
                            }
                        });
                        return;
                    }
                    
                    const byParam = {};
                    filtered.forEach(p => {
                        const val = p[paramName];
                        if (val === undefined || val === null) return;
                        const key = val.toFixed(3);
                        if (!byParam[key]) byParam[key] = { val, growths: [] };
                        byParam[key].growths.push(p.growth);
                    });
                    
                    const sorted = Object.values(byParam).sort((a, b) => a.val - b.val);
                    const xVals = sorted.map(p => p.val);
                    const means = sorted.map(p => calcStats(p.growths).mean);
                    const stds = sorted.map(p => calcStats(p.growths).std);
                    
                    charts[effect] = new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: xVals,
                            datasets: [{
                                label: 'Mean Growth',
                                data: means,
                                borderColor: effectColors[effect],
                                backgroundColor: effectColors[effect] + '20',
                                borderWidth: 3,
                                pointRadius: 5,
                                pointHoverRadius: 7,
                                fill: true,
                                tension: 0.3
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    callbacks: {
                                        label: (ctx) => {
                                            const idx = ctx.dataIndex;
                                            const n = sorted[idx].growths.length;
                                            return [
                                                `Mean: ${means[idx].toFixed(4)}`,
                                                `Std: ${stds[idx].toFixed(4)}`,
                                                `n: ${n}`
                                            ];
                                        }
                                    }
                                }
                            },
                            scales: {
                                x: {
                                    title: { display: true, text: paramInfo.label, color: '#94a3b8' },
                                    grid: { color: 'rgba(148,163,184,0.1)' },
                                    ticks: { color: '#94a3b8', maxTicksLimit: 8 }
                                },
                                y: {
                                    title: { display: true, text: 'Growth', color: '#94a3b8' },
                                    grid: { color: 'rgba(148,163,184,0.1)' },
                                    ticks: { color: '#94a3b8' }
                                }
                            }
                        }
                    });
                });
            }
            
            function renderComparison() {
                const ctx = document.getElementById('chart-comparison');
                if (!ctx) return;
                
                if (charts.comparison) charts.comparison.destroy();
                
                const effects = ['AC', 'DC', 'AMF', 'CMF'];
                const means = effects.map(e => {
                    const growths = dataPoints.filter(p => p.effect_type === e).map(p => p.growth);
                    return calcStats(growths).mean;
                });
                
                charts.comparison = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: effects,
                        datasets: [{
                            data: means,
                            backgroundColor: effects.map(e => effectColors[e] + 'CC'),
                            borderColor: effects.map(e => effectColors[e]),
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            x: { grid: { color: 'rgba(148,163,184,0.1)' }, ticks: { color: '#94a3b8' } },
                            y: { 
                                title: { display: true, text: 'Mean Growth', color: '#94a3b8' },
                                grid: { color: 'rgba(148,163,184,0.1)' }, 
                                ticks: { color: '#94a3b8' }
                            }
                        }
                    }
                });
            }
            
            function updateStats() {
                ['AC', 'DC', 'AMF', 'CMF'].forEach(effect => {
                    const count = dataPoints.filter(p => p.effect_type === effect).length;
                    const el = document.getElementById(`stat-${effect.toLowerCase()}`);
                    if (el) el.textContent = count;
                });
            }
            
            // Event listeners
            ['AC', 'DC', 'AMF', 'CMF'].forEach(effect => {
                const select = document.getElementById(`${effect.toLowerCase()}-param-select`);
                if (select) {
                    select.addEventListener('change', (e) => {
                        selectedParams[effect] = e.target.value;
                        renderParameterCharts();
                    });
                }
            });
            
            document.getElementById('refresh-btn')?.addEventListener('click', fetchData);
            document.getElementById('refresh-rate')?.addEventListener('change', (e) => {
                refreshRate = parseInt(e.target.value);
                setupRefresh();
            });
            
            function setupRefresh() {
                if (refreshInterval) clearInterval(refreshInterval);
                if (refreshRate > 0) refreshInterval = setInterval(fetchData, refreshRate);
            }
            
            // Initialize
            console.log('Initializing Chart.js graphs...');
            updateAllGraphs();
            fetchData();
            setupRefresh();
        </script>
    </body>
</html>
