---
// Left sidebar with plants and effects resources
import Icon from '../common/Icon.astro';
---

<aside id="left-pane" class="flex flex-col bg-white border-r border-gray-300" style="width: 320px; min-width: 0;">
    <!-- Header -->
    <div id="left-pane-header" class="flex items-center justify-between p-2 h-14 bg-gray-100 border-b border-gray-300">
        <div class="flex items-center gap-2">
            <button id="toggle-left-pane-btn" class="p-1 hover:bg-gray-200 rounded" title="Collapse/Expand">
                <Icon name="chevron-right" class="w-4 h-4 text-gray-600" />
            </button>
            <h2 id="left-pane-title" class="text-sm font-semibold text-gray-900">Resources</h2>
        </div>
    </div>
    
    <div id="left-pane-content" class="flex-1 overflow-hidden flex flex-col">
        <!-- Plants Section -->
        <div class="border-b border-gray-200">
            <button id="toggle-plants-section-btn" class="w-full flex items-center justify-between px-4 py-2 hover:bg-gray-50">
                <div class="flex items-center gap-2">
                    <Icon name="chevron-down" class="w-3 h-3 text-gray-500" />
                    <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-600">Plants</h3>
                </div>
                <span id="plant-count" class="text-xs font-mono text-green-600 bg-green-100 px-1.5 py-0.5 rounded">0</span>
            </button>
            <div id="plants-section" class="px-2 pb-2">
                <div id="plants-list" class="grid grid-cols-2 gap-1.5 max-h-48 overflow-y-auto p-1 border border-dashed border-gray-300 rounded bg-gray-50/50 min-h-[80px]">
                    <!-- Plants populated by JS -->
                </div>
            </div>
        </div>
        
        <!-- Effects Section -->
        <div class="flex-1 flex flex-col min-h-0">
            <button id="toggle-effects-section-btn" class="w-full flex items-center justify-between px-4 py-2 hover:bg-gray-50">
                <div class="flex items-center gap-2">
                    <Icon name="chevron-down" class="w-3 h-3 text-gray-500" />
                    <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-600">EM Effects</h3>
                </div>
            </button>
            <div id="effects-section" class="flex-1 overflow-y-auto px-3 pb-3">
                <div class="grid grid-cols-2 gap-2">
                    <!-- AC Effect -->
                    <div class="effect-draggable p-2 bg-gradient-to-br from-orange-50 to-amber-50 border border-orange-200 rounded cursor-move hover:from-orange-100 hover:to-amber-100 hover:border-orange-300 transition-all" draggable="true" data-effect-type="AC">
                        <div class="flex items-center gap-1 mb-1">
                            <span class="text-lg">⚡</span>
                            <span class="text-xs font-bold text-orange-700">AC</span>
                        </div>
                        <p class="text-xs text-gray-600 leading-tight">Alternating Current</p>
                    </div>
                    
                    <!-- DC Effect -->
                    <div class="effect-draggable p-2 bg-gradient-to-br from-red-50 to-rose-50 border border-red-200 rounded cursor-move hover:from-red-100 hover:to-rose-100 hover:border-red-300 transition-all" draggable="true" data-effect-type="DC">
                        <div class="flex items-center gap-1 mb-1">
                            <span class="text-lg">🔋</span>
                            <span class="text-xs font-bold text-red-700">DC</span>
                        </div>
                        <p class="text-xs text-gray-600 leading-tight">Direct Current</p>
                    </div>
                    
                    <!-- AMF Effect -->
                    <div class="effect-draggable p-2 bg-gradient-to-br from-purple-50 to-violet-50 border border-purple-200 rounded cursor-move hover:from-purple-100 hover:to-violet-100 hover:border-purple-300 transition-all" draggable="true" data-effect-type="AMF">
                        <div class="flex items-center gap-1 mb-1">
                            <span class="text-lg">🧲</span>
                            <span class="text-xs font-bold text-purple-700">AMF</span>
                        </div>
                        <p class="text-xs text-gray-600 leading-tight">Alternating Magnetic Field</p>
                    </div>
                    
                    <!-- CMF Effect -->
                    <div class="effect-draggable p-2 bg-gradient-to-br from-indigo-50 to-blue-50 border border-indigo-200 rounded cursor-move hover:from-indigo-100 hover:to-blue-100 hover:border-indigo-300 transition-all" draggable="true" data-effect-type="CMF">
                        <div class="flex items-center gap-1 mb-1">
                            <span class="text-lg">🧭</span>
                            <span class="text-xs font-bold text-indigo-700">CMF</span>
                        </div>
                        <p class="text-xs text-gray-600 leading-tight">Constant Magnetic Field</p>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Trash Zone -->
        <div class="border-t border-gray-200 p-3">
            <div id="trash-zone" class="p-4 border-2 border-dashed border-gray-300 rounded-lg bg-gray-50 text-center transition-all hover:border-red-300 hover:bg-red-50">
                <span class="text-2xl">🗑️</span>
                <p class="text-xs text-gray-500 mt-1">Drop here to remove</p>
            </div>
        </div>
    </div>
</aside>
