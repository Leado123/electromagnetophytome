---
export interface Props {
    id: string;
    title: string;
    icon: string;
    colorClass: string;
    paramOptions: { value: string; label: string }[];
    paramSelectId: string;
}

const { id, title, icon, colorClass, paramOptions, paramSelectId } = Astro.props;
---

<div class="bg-slate-800 rounded-xl border border-slate-700 p-4 flex flex-col" style="min-height: 380px;">
    <div class="flex items-center justify-between mb-2">
        <h2 class={`text-base font-bold ${colorClass}`}>{icon} {title}</h2>
        <select id={paramSelectId} class="px-2 py-1 bg-slate-700 border border-slate-600 rounded text-xs text-white">
            {paramOptions.map((opt) => (
                <option value={opt.value}>{opt.label}</option>
            ))}
        </select>
    </div>
    <div class="flex-1" style="min-height: 320px;">
        <canvas id={id}></canvas>
    </div>
</div>
